# Hybrid RAG Forensic Intelligence Platform — Environment Variables Example
# Copy this file to .env and configure your secrets

# ── LLM CONFIGURATION ─────────────────────────────────────────
# Options: 'gemini', 'openai', 'ollama', or 'mock'
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash

# Optional OpenAI settings (if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# ── EMBEDDING MODEL ───────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── DATABASE CONFIGURATION ────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_NAME=forensic_coc

# ── JWT SECRET ────────────────────────────────────────────────
SECRET_KEY=your_jwt_secret_key_here
